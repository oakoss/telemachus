# Copy to `.env` (gitignored) and adjust. Vars are grouped by consumer below.

# --- App (validated by createAppEnv) ---

# Server Postgres connection — required. Match the compose creds + port below.
DATABASE_URL=postgres://telemachus:telemachus@localhost:5432/telemachus

# trace | debug | info | warn | error | fatal (default: info)
LOG_LEVEL=info

# development | production | test (default: development)
NODE_ENV=development

# --- Dev backing services (read by docker-compose.yml) ---

POSTGRES_USER=telemachus
POSTGRES_PASSWORD=telemachus
POSTGRES_DB=telemachus

# Host port for dev Postgres. Bump (e.g. 5433) if 5432 is taken locally —
# then mirror the new port in DATABASE_URL above.
POSTGRES_PORT=5432
