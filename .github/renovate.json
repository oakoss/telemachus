{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],
  "automerge": true,
  "branchPrefix": "chore/deps-",
  "platformAutomerge": true,
  "minimumReleaseAge": "1 day",
  "rangeStrategy": "bump",
  "schedule": ["before 6am on the first day of the month"],
  "timezone": "America/Chicago",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Pin nitro-nightly deliberately (TanStack Start's Vite plugin needs it); bump it manually, not via Renovate.",
      "matchDepNames": ["nitro"],
      "enabled": false
    },
    { "matchUpdateTypes": ["major"], "automerge": false },
    {
      "matchPackageNames": [
        "react",
        "react-dom",
        "better-auth",
        "drizzle-orm",
        "pg",
        "@tanstack/*"
      ],
      "automerge": false
    },
    {
      "matchPackageNames": [
        "oxlint",
        "eslint-plugin-oxlint",
        "oxlint-tsgolint"
      ],
      "groupName": "oxlint"
    },
    { "matchDepTypes": ["peerDependencies"], "rangeStrategy": "widen" }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"],
    "labels": ["lockfile"]
  }
}
